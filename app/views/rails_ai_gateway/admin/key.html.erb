<div class="focus-page">
  <div class="badge-tag">Credential Issued</div>
  <h1>Save this key now</h1>
  <p class="page-subtitle">Only its SHA-256 digest is stored. This token cannot be displayed again once you leave this page.</p>
  <div class="token-card">
    <label for="new-token"><%= @key.name %></label>
    <textarea id="new-token" readonly rows="3" autocomplete="off" spellcheck="false"><%= @token %></textarea>
  </div>
  <%= link_to "Return to Gateway Console", admin_path, class: "btn btn-primary" %>
</div>
