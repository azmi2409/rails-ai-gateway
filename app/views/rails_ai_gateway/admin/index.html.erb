<div class="page-header">
  <div class="header-content">
    <div class="badge-tag">Control Plane</div>
    <h1 class="page-title">AI Gateway Console</h1>
    <p class="page-subtitle">Configure OpenAI-compatible providers, fallback routing chains, and access keys in your Rails host database.</p>
  </div>
  <div class="endpoint-box">
    <span class="endpoint-label">Gateway API Endpoint</span>
    <code class="endpoint-url"><%= request.base_url %><%= request.script_name %>/v1</code>
    <span class="endpoint-hint">Bearer authentication required</span>
  </div>
</div>

<div class="stats-grid" aria-label="Gateway Metrics">
  <div class="stat-card">
    <span class="stat-label">Requests (24h)</span>
    <strong class="stat-value"><%= @requests %></strong>
    <span class="stat-meta">Total proxy calls</span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Errors (24h)</span>
    <strong class="stat-value"><%= @errors %></strong>
    <span class="stat-meta"><%= @requests.zero? ? "No recent traffic" : "#{((@errors.to_f / @requests) * 100).round(1)}% error rate" %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Average Latency</span>
    <strong class="stat-value"><%= @latency %><small>ms</small></strong>
    <span class="stat-meta">Completed attempts</span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Active Routes</span>
    <strong class="stat-value"><%= @routes.size %></strong>
    <span class="stat-meta"><%= @providers.count(&:enabled?) %> of <%= @providers.size %> providers enabled</span>
  </div>
</div>

<section class="panel-section usage-panel" aria-labelledby="usage-heading">
  <div class="section-header">
    <div>
      <h2 class="section-title" id="usage-heading">Token Usage by Model</h2>
      <p class="section-desc">All-time totals reported by upstream providers. Missing usage is recorded as zero, never estimated.</p>
    </div>
  </div>
  <div class="table-container">
    <table class="data-table">
      <thead><tr><th scope="col">Public Model</th><th scope="col">Input Tokens</th><th scope="col">Output Tokens</th><th scope="col">Total Tokens</th></tr></thead>
      <tbody>
        <% if @model_usage.empty? %>
          <tr><td data-label="Model" colspan="4" class="empty-state">No token usage reported yet.</td></tr>
        <% else %>
          <% @model_usage.each do |model, input_tokens, output_tokens| %>
            <tr>
              <td data-label="Model"><code><%= model %></code></td>
              <td data-label="Input"><%= number_with_delimiter(input_tokens) %></td>
              <td data-label="Output"><%= number_with_delimiter(output_tokens) %></td>
              <td data-label="Total"><strong><%= number_with_delimiter(input_tokens + output_tokens) %></strong></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section id="providers" class="panel-section">
  <div class="section-header">
    <div>
      <h2 class="section-title">Upstream Providers</h2>
      <p class="section-desc">OpenAI-compatible endpoints. Provider credentials are encrypted at rest with ActiveRecord Encryption.</p>
    </div>
  </div>

  <div class="provider-catalog" aria-label="Provider templates">
    <% @provider_templates.each do |template_id, template| %>
      <% connected = @providers.any? { |provider| provider.base_url == template[:base_url] } %>
      <div class="provider-template <%= "template-connected" if connected %>">
        <button type="button" class="provider-template-button" <%= "disabled" if connected %> data-provider-connect data-template="<%= template_id %>" data-provider-name="<%= template[:name] %>" data-logo="<%= provider_logo_path(template: template_id) %>">
          <%= image_tag provider_logo_path(template: template_id), class: "provider-logo", alt: "#{template[:name]} logo", width: 38, height: 38 %>
          <span class="provider-template-copy"><strong><%= template[:name] %></strong><small><%= connected ? "Connected" : "Add API key to connect" %></small></span>
          <span class="template-state"><%= connected ? "Configured" : "+ Connect" %></span>
        </button>
      </div>
    <% end %>
  </div>

  <dialog id="provider-connect-dialog" class="connect-dialog" aria-labelledby="connect-dialog-title">
    <%= form_with url: providers_path, method: :post, local: true, class: "connect-dialog-card" do |form| %>
      <div class="connect-dialog-header">
        <img data-dialog-logo alt="" width="44" height="44" class="provider-logo">
        <div><span class="dialog-eyebrow">Provider connection</span><h3 id="connect-dialog-title">Connect provider</h3></div>
        <button type="button" class="dialog-close" data-dialog-close aria-label="Close provider connection">×</button>
      </div>
      <p class="dialog-copy">Credential is encrypted with ActiveRecord Encryption. It is never returned by the admin UI.</p>
      <%= hidden_field_tag :template, "", data: { dialog_template: true } %>
      <div class="form-group">
        <%= label_tag :api_key, "API Key", data: { dialog_key_label: true } %>
        <%= password_field_tag :api_key, nil, required: true, autocomplete: "new-password", placeholder: "Paste provider API key", data: { dialog_api_key: true } %>
      </div>
      <div class="dialog-actions"><button type="button" class="btn btn-secondary" data-dialog-close>Cancel</button><%= form.submit "Connect Provider", class: "btn btn-primary", data: { dialog_submit: true } %></div>
    <% end %>
  </dialog>

  <h3 class="subsection-title">Configured Providers</h3>

  <div class="items-list">
    <% @providers.each do |provider| %>
      <details class="item-accordion">
        <summary class="accordion-summary">
          <div class="item-info">
            <span class="item-name"><%= provider.name %></span>
            <span class="item-sub"><%= provider.base_url %></span>
          </div>
          <div class="item-actions">
            <span class="pill-badge <%= provider.enabled? ? 'pill-success' : 'pill-neutral' %>">
              <i class="dot" aria-hidden="true"></i><%= provider.enabled? ? "Enabled" : "Disabled" %>
            </span>
          </div>
        </summary>
        <div class="accordion-body">
          <%= form_with scope: :provider, url: provider_path(provider), method: :patch, local: true, class: "form-grid", namespace: "provider_#{provider.id}" do |form| %>
            <div class="form-group">
              <%= form.label :name, "Provider Name" %>
              <%= form.text_field :name, value: provider.name, required: true %>
            </div>
            <div class="form-group">
              <%= form.label :base_url, "API Base URL" %>
              <%= form.url_field :base_url, value: provider.base_url, required: true %>
            </div>
            <div class="form-group">
              <%= form.label :api_key, "Update API Key (blank keeps current)" %>
              <%= form.password_field :api_key, autocomplete: "new-password" %>
            </div>
            <div class="form-group checkbox-group">
              <%= form.check_box :enabled, checked: provider.enabled?, id: "enabled_#{provider.id}" %>
              <%= form.label :enabled, "Enabled for routing", for: "enabled_#{provider.id}" %>
            </div>
            <div class="form-group checkbox-group">
              <%= check_box_tag :clear_api_key, "1", false, id: "clear_key_#{provider.id}" %>
              <%= label_tag "clear_key_#{provider.id}", "Remove stored API key" %>
            </div>
            <div class="form-submit">
              <%= form.submit "Save Changes", class: "btn btn-primary" %>
            </div>
          <% end %>
          <div class="danger-zone">
            <div><strong>Delete provider</strong><small>Provider must have no model routes.</small></div>
            <%= button_to "Delete Provider", provider_path(provider), method: :delete, class: "btn btn-danger-outline", aria: { label: "Delete provider #{provider.name}" }, form: { data: { turbo_confirm: "Delete provider '#{provider.name}'? This cannot be undone." } } %>
          </div>
        </div>
      </details>
    <% end %>

    <details class="item-accordion create-accordion" <%= "open" if @providers.empty? %>>
      <summary class="accordion-summary create-summary">
        <span class="create-trigger">
          <svg class="icon-plus" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 3.5a.75.75 0 0 1 .75.75v3h3a.75.75 0 0 1 0 1.5h-3v3a.75.75 0 0 1-1.5 0v-3h-3a.75.75 0 0 1 0-1.5h3v-3A.75.75 0 0 1 8 3.5z"/></svg>
          Add Upstream Provider
        </span>
      </summary>
      <div class="accordion-body">
        <%= form_with scope: :provider, url: providers_path, local: true, class: "form-grid", namespace: "new_provider" do |form| %>
          <div class="form-group">
            <%= form.label :name, "Provider Name" %>
            <%= form.text_field :name, required: true, placeholder: "e.g. OpenAI, DeepSeek, Local 9Router" %>
          </div>
          <div class="form-group">
            <%= form.label :base_url, "API Base URL" %>
            <%= form.url_field :base_url, required: true, placeholder: "https://api.openai.com/v1" %>
          </div>
          <div class="form-group">
            <%= form.label :api_key, "API Key (optional for local/unauthenticated proxies)" %>
            <%= form.password_field :api_key, autocomplete: "new-password" %>
          </div>
          <div class="form-submit">
            <%= form.submit "Create Provider", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </details>
  </div>
</section>

<section id="models" class="panel-section">
  <div class="section-header">
    <div>
      <h2 class="section-title">Model Routing</h2>
      <p class="section-desc">Map virtual model names to target upstreams. Routes with matching public names form an automatic fallback chain ordered by priority (lower priority runs first).</p>
    </div>
  </div>

  <div class="items-list">
    <% @routes.each do |route| %>
      <details class="item-accordion">
        <summary class="accordion-summary">
          <div class="item-info">
            <span class="item-name"><%= route.name %></span>
            <span class="item-sub">maps to <code><%= route.upstream_model %></code> via <%= route.provider.name %></span>
            <span class="capability-list"><% route.capabilities.each do |capability| %><span><%= capability %></span><% end %></span>
          </div>
          <div class="item-actions">
            <span class="priority-tag">Priority <%= route.priority %></span>
          </div>
        </summary>
        <div class="accordion-body">
          <%= form_with scope: :model_route, url: model_route_path(route), method: :patch, local: true, class: "form-grid", namespace: "route_#{route.id}" do |form| %>
            <div class="form-group">
              <%= form.label :name, "Public Model Name" %>
              <%= form.text_field :name, value: route.name, required: true %>
            </div>
            <div class="form-group">
              <%= form.label :provider_id, "Target Provider" %>
              <%= form.collection_select :provider_id, @providers, :id, :name, selected: route.provider_id %>
            </div>
            <div class="form-group">
              <%= form.label :upstream_model, "Upstream Model ID" %>
              <%= form.text_field :upstream_model, value: route.upstream_model, required: true %>
            </div>
            <div class="form-group">
              <%= form.label :priority, "Fallback Priority" %>
              <%= form.number_field :priority, value: route.priority, min: 0, required: true %>
            </div>
            <div class="form-group form-group-wide">
              <%= form.label :system_prompt, "Injected System Prompt (optional)" %>
              <%= form.text_area :system_prompt, value: route.system_prompt, rows: 5, maxlength: 20_000, placeholder: "Applied before client messages when this route is selected." %>
              <small class="field-hint">Stored with this route. Never written to request logs.</small>
            </div>
            <div class="form-group form-group-wide">
              <%= form.label :query_keywords, "Query Router Keywords (optional)" %>
              <%= form.text_area :query_keywords, value: route.query_keywords.join(", "), rows: 2, maxlength: 5_000, placeholder: "code review, ruby, debugging" %>
              <small class="field-hint">Comma or line-separated literal matches. Matching routes run before generic fallbacks.</small>
            </div>
            <fieldset class="capability-fieldset form-group-wide">
              <legend>Model Capabilities</legend>
              <div class="capability-options">
                <% RailsAiGateway::ModelRoute::CAPABILITIES.each do |capability| %>
                  <label><%= check_box_tag "model_route[capabilities][]", capability, route.capabilities.include?(capability), id: "route_#{route.id}_capability_#{capability}" %><span><%= capability.capitalize %></span></label>
                <% end %>
              </div>
            </fieldset>
            <div class="form-submit">
              <%= form.submit "Save Route", class: "btn btn-primary" %>
            </div>
          <% end %>
          <div class="danger-zone">
            <div><strong>Delete model route</strong><small>Removes this destination from its fallback chain.</small></div>
            <%= button_to "Delete Model", model_route_path(route), method: :delete, class: "btn btn-danger-outline", aria: { label: "Delete model route #{route.name} to #{route.upstream_model}" }, form: { data: { turbo_confirm: "Delete model route '#{route.name}' to '#{route.upstream_model}'?" } } %>
          </div>
        </div>
      </details>
    <% end %>

    <details class="item-accordion create-accordion">
      <summary class="accordion-summary create-summary">
        <span class="create-trigger">
          <svg class="icon-plus" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 3.5a.75.75 0 0 1 .75.75v3h3a.75.75 0 0 1 0 1.5h-3v3a.75.75 0 0 1-1.5 0v-3h-3a.75.75 0 0 1 0-1.5h3v-3A.75.75 0 0 1 8 3.5z"/></svg>
          Add Model Route
        </span>
      </summary>
      <div class="accordion-body">
        <%= form_with scope: :model_route, url: model_routes_path, local: true, class: "form-grid", namespace: "new_route" do |form| %>
          <div class="form-group">
            <%= form.label :name, "Public Model Name" %>
            <%= form.text_field :name, required: true, placeholder: "e.g. fast-chat, smart-code" %>
          </div>
          <div class="form-group">
            <%= form.label :provider_id, "Target Provider" %>
            <%= form.collection_select :provider_id, @providers, :id, :name %>
          </div>
          <div class="form-group">
            <%= form.label :upstream_model, "Upstream Model Identifier" %>
            <%= form.text_field :upstream_model, required: true, placeholder: "e.g. gpt-5.6-luna, claude-3-7-sonnet" %>
          </div>
          <div class="form-group">
            <%= form.label :priority, "Priority (0 = primary, 1+ = fallback)" %>
            <%= form.number_field :priority, value: 0, min: 0, required: true %>
          </div>
          <div class="form-group form-group-wide">
            <%= form.label :system_prompt, "Injected System Prompt (optional)" %>
            <%= form.text_area :system_prompt, rows: 5, maxlength: 20_000, placeholder: "Applied before client messages when this route is selected." %>
            <small class="field-hint">Stored with this route. Never written to request logs.</small>
          </div>
          <div class="form-group form-group-wide">
            <%= form.label :query_keywords, "Query Router Keywords (optional)" %>
            <%= form.text_area :query_keywords, rows: 2, maxlength: 5_000, placeholder: "code review, ruby, debugging" %>
            <small class="field-hint">Comma or line-separated literal matches. Matching routes run before generic fallbacks.</small>
          </div>
          <fieldset class="capability-fieldset form-group-wide">
            <legend>Model Capabilities</legend>
            <div class="capability-options">
              <% RailsAiGateway::ModelRoute::CAPABILITIES.each do |capability| %>
                <label><%= check_box_tag "model_route[capabilities][]", capability, capability == "text", id: "new_route_capability_#{capability}" %><span><%= capability.capitalize %></span></label>
              <% end %>
            </div>
          </fieldset>
          <div class="form-submit">
            <%= form.submit "Create Route", class: "btn btn-primary", disabled: @providers.empty? %>
          </div>
        <% end %>
      </div>
    </details>
  </div>
</section>

<section id="keys" class="panel-section">
  <div class="section-header">
    <div>
      <h2 class="section-title">Gateway Keys</h2>
      <p class="section-desc">Client authentication tokens. Only SHA-256 digests are stored. Restrict access to specific models or leave empty to allow all.</p>
    </div>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Key Name</th>
          <th scope="col">Prefix</th>
          <th scope="col">Allowed Models</th>
          <th scope="col">Expires</th>
          <th scope="col">Status</th>
          <th scope="col" class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @keys.each do |key| %>
          <% key_status = key.revoked_at ? "Revoked" : (key.expires_at&.past? ? "Expired" : "Active") %>
          <tr>
            <td data-label="Name"><strong><%= key.name %></strong></td>
            <td data-label="Prefix"><code class="code-badge"><%= key.prefix %>…</code></td>
            <td data-label="Models"><%= key.allowed_models.empty? ? '<span class="text-muted">All models</span>'.html_safe : key.allowed_models.join(", ") %></td>
            <td data-label="Expires"><%= key.expires_at ? key.expires_at.strftime("%b %d, %Y") : '<span class="text-muted">Never</span>'.html_safe %></td>
            <td data-label="Status">
              <span class="status-pill status-<%= key_status.downcase %>"><%= key_status %></span>
            </td>
            <td data-label="Action" class="text-right">
              <% unless key.revoked_at %>
                <%= button_to "Revoke", gateway_key_path(key), method: :delete, class: "btn btn-sm btn-danger-outline", aria: { label: "Revoke #{key.name}" }, data: { confirm: "Revoke key '#{key.name}'?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <details class="item-accordion create-accordion mt-4">
    <summary class="accordion-summary create-summary">
      <span class="create-trigger">
        <svg class="icon-plus" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 3.5a.75.75 0 0 1 .75.75v3h3a.75.75 0 0 1 0 1.5h-3v3a.75.75 0 0 1-1.5 0v-3h-3a.75.75 0 0 1 0-1.5h3v-3A.75.75 0 0 1 8 3.5z"/></svg>
        Issue New Gateway Key
      </span>
    </summary>
    <div class="accordion-body">
      <%= form_with scope: :gateway_key, url: gateway_keys_path, local: true, class: "form-grid" do |form| %>
        <div class="form-group">
          <%= form.label :name, "Key Label" %>
          <%= form.text_field :name, required: true, placeholder: "e.g. Production Mobile App, Internal ETL" %>
        </div>
        <div class="form-group">
          <%= form.label :allowed_models, "Allowed Models (comma separated, leave blank for all)" %>
          <%= form.text_field :allowed_models, placeholder: "fast-chat, luna, embeddings" %>
        </div>
        <div class="form-group">
          <%= form.label :expires_at, "Expiration Date (#{Time.zone.name})" %>
          <%= form.datetime_local_field :expires_at %>
        </div>
        <div class="form-submit">
          <%= form.submit "Generate Key", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </details>
</section>

<section id="logs" class="panel-section">
  <div class="section-header">
    <div>
      <h2 class="section-title">Request Logs</h2>
      <p class="section-desc">Audit trail of incoming proxy requests. Logs record request metadata and latency. Content payloads are never stored.</p>
    </div>
  </div>

  <%= form_with url: admin_path(anchor: "logs"), method: :get, local: true, class: "filter-toolbar" do |form| %>
    <div class="filter-group">
      <%= form.label :model, "Filter by Model", class: "filter-label" %>
      <%= form.text_field :model, value: params[:model], placeholder: "All models", class: "filter-input" %>
    </div>
    <div class="filter-group">
      <%= form.label :status, "Filter by Status", class: "filter-label" %>
      <%= form.number_field :status, value: params[:status], min: 100, max: 599, placeholder: "e.g. 200, 429", class: "filter-input" %>
    </div>
    <div class="filter-actions">
      <%= form.submit "Apply Filters", class: "btn btn-secondary" %>
      <% if params[:model].present? || params[:status].present? %>
        <%= link_to "Clear", admin_path(anchor: "logs"), class: "btn btn-text" %>
      <% end %>
    </div>
  <% end %>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Time</th>
          <th scope="col">Model</th>
          <th scope="col">Status</th>
          <th scope="col">Latency</th>
          <th scope="col">Tokens</th>
          <th scope="col">Details</th>
        </tr>
      </thead>
      <tbody>
        <% @logs.each do |log| %>
          <tr>
            <td data-label="Time">
              <span class="time-col">
                <%= log.created_at.strftime("%b %d") %>
                <small><%= log.created_at.strftime("%H:%M:%S") %></small>
              </span>
            </td>
            <td data-label="Model"><code><%= log.model %></code></td>
            <td data-label="Status">
              <% st = log.status.to_i %>
              <span class="status-pill status-<%= (200..299).cover?(st) ? 'active' : (st >= 400 ? 'error' : 'pending') %>">
                <%= log.status || "Pending" %>
              </span>
            </td>
            <td data-label="Latency"><%= log.duration_ms ? "#{log.duration_ms} ms" : "—" %></td>
            <td data-label="Tokens"><%= log.usage&.fetch("total_tokens", nil) || "—" %></td>
            <td data-label="Details">
              <details class="details-dropdown">
                <summary class="details-trigger">View attempts</summary>
                <div class="details-popup">
                  <span class="uuid-text">UUID: <%= log.request_id %></span>
                  <pre class="json-code"><%= JSON.pretty_generate(log.attempts) %></pre>
                </div>
              </details>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @logs.size == 50 %>
    <div class="pagination-footer">
      <%= link_to "Older Requests →", admin_path(before: @logs.last.id, model: params[:model], status: params[:status], anchor: "logs"), class: "btn btn-secondary" %>
    </div>
  <% end %>
</section>
